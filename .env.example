# 复制这个文件为 .env，然后填入自己的值
# .env 已被 .gitignore 忽略，不会上传到 GitHub，也不会进 Docker 镜像

# 硅基流动的 key（https://cloud.siliconflow.cn/account/ak）
LLM_API_KEY=sk-替换成你自己的key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# 把文字变成向量的模型（检索用）
EMBED_MODEL=BAAI/bge-m3

# 精排模型。4B 比免费的 bge 强很多：20 条最难的问法 8/20 -> 14/20，
# AUC 0.648 -> 0.875，代价是每次精排 0.53s -> 1.07s，约 ¥0.14/百万 token
RERANK_MODEL=Qwen/Qwen3-Reranker-4B

# 精排阈值。这个数是 4B 在其输出分布上扫出来的，换模型必须重扫 ——
# 同一个 0.95 在 bge 上等于「全部拒答」，在 4B 上才是合理的分界线
RERANK_THRESHOLD=0.95
